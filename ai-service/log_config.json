{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "context": {
      "()": "app.logging_setup.ContextFilter"
    }
  },
  "formatters": {
    "json": {
      "()": "app.logging_setup.JsonFormatter"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": [
        "context"
      ]
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": [
      "stdout"
    ]
  },
  "loggers": {
    "uvicorn": {
      "handlers": [],
      "propagate": true
    },
    "uvicorn.error": {
      "handlers": [],
      "propagate": true
    },
    "uvicorn.access": {
      "handlers": [],
      "propagate": false,
      "level": "CRITICAL"
    },
    "anthropic": {
      "level": "INFO"
    },
    "httpx": {
      "level": "INFO"
    },
    "httpcore": {
      "level": "INFO"
    },
    "urllib3": {
      "level": "INFO"
    }
  }
}
