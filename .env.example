# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Effort: low | medium | high | xhigh | max (empty = API default for the model)
CLAUDE_EFFORT=low
# Limits: output tokens per Claude call, model->tool rounds per request, request size
CLAUDE_MAX_TOKENS=1024
AGENT_MAX_STEPS=4
MAX_MESSAGES=4
MAX_MESSAGE_CHARS=500
# FAQ hits below this cosine score are not "data" (no data -> fixed refusal). Measured on e5-large:
# in-topic Polish questions 0.83-0.88, in-topic English/Ukrainian ~0.80, off-topic 0.72-0.81.
FAQ_MIN_SCORE=0.82

# Logging: JSON lines on stdout; LOG_ID identifies the developer/instance, debug logs are off when ENVIRONMENT=prod
LOG_ID=dev
ENVIRONMENT=local

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=demo
MYSQL_READONLY_USER=readonly
MYSQL_READONLY_PASSWORD=change-me-readonly

# Host port of ai-service (the only published port)
AI_SERVICE_PORT=8000
