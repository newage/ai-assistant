# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Effort: low | medium | high | xhigh | max (empty = API default for the model)
CLAUDE_EFFORT=low
# Limits: output tokens per Claude call, request size
CLAUDE_MAX_TOKENS=1024
MAX_MESSAGES=4
MAX_MESSAGE_CHARS=500
# FAQ hits below this cosine score are not "data" (no data -> fixed refusal). Measured on e5-large:
# top-hit score on the English FAQ: in-topic English 0.79-0.85, Ukrainian 0.75-0.83, Polish 0.76-0.81;
# off-topic / user-data questions 0.67-0.79. 0.80 rejects all off-topic ones but also some short in-topic UK/PL questions.
FAQ_MIN_SCORE=0.84

PINECONE_API_KEY=

# Logging: JSON lines on stdout; LOG_ID identifies the developer/instance, debug logs are off when ENVIRONMENT=prod
LOG_ID=dev
ENVIRONMENT=local

# Host port of ai-service (the only published port)
AI_SERVICE_PORT=8000
